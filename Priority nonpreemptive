process = ["p1", "p2", "p3", "p4"]
at = [0,3,1,2]
bt = [3,2,2,1]
priority = [4, 0, 2, 1]


n = len(process)

ct = [0] * n
wt = [0] * n
tat = [0] * n


time = 0
completed = 0

while completed < n:

    x = -1
    for i in range(n):

        if at[i] <= time and ct[i] == 0:

            if x == -1 or priority[i] < priority[x]:
                x = i

    if x == -1:
        time += 1


    else:
        time += bt[x]
        ct[x] = time
        completed += 1


for i in range(n):
    tat[i] = ct[i] - at[i]
    wt[i] = tat[i] - bt[i]


print("Process\tAT\tBT\tPriority\tCT\tTAT\tWT")

for i in range(n):
    print(process[i], "\t", "\t", at[i], "\t", bt[i],"\t", priority[i], "\t", ct[i], "\t", tat[i], "\t", wt[i])

avg_tat = sum(tat)/n
avg_wt = sum(wt)/n

print("\nAverage TAT =", avg_tat)
print("Average WT =", avg_wt)
print("\n")

