process = ["p1", "p2", "p3", "p4", "p5"]
at = [3,0,2,1,4]
bt = [4,4,3,6,2]
priority = [2,0,1, 1, 3]


n = len(process)

ct = [0] * n
wt = [0] * n
tat = [0] * n

tq= 3
priority1 = bt.copy()
time = 0
completed = 0

while completed < n:

    x = -1
    for i in range(n):

        if at[i] <= time and priority1[i] > 0:

            if x == -1 or (priority[i] < priority[x]) or (priority[i] == priority[x]) and at[i] < at [x]:
                x = i

    if x == -1:
        time += 1

    else:
        if priority1[x] > tq:
            time += tq
            priority1[x] -= tq

        else:
            time += priority1[x]
            priority1[x] = 0
            ct[x] = time
            completed += 1


for i in range(n):
    tat[i] = ct[i] - at[i]
    wt[i] = tat[i] - bt[i]


print("Process\tAT\tBT\tCT\tTAT\tWT")


for i in range(n):
    print(process[i], "\t\t" , at[i] ,"\t", bt[i], "\t", ct[i], "\t", tat[i], "\t" ,wt[i])

avg_tat = sum(tat)/n
avg_wt = sum(wt)/n

print("\nAverage TAT =", avg_tat)
print("Average WT =", avg_wt)
print("\n")
